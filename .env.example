# Momence Public API credentials, used to fetch live prices for the pricing,
# gift card and new client pages. Create an API client in the Momence
# dashboard. If these are missing, the fallback prices in
# components/Pricing/pricingData.tsx are shown instead.
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
